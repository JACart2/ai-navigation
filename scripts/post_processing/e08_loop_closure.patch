+void FrameToFrameLoopClosure::generate_scan_context_endpoint_hypotheses()
+{
+    ASSERT_(state_.sm);
+    const auto& sm = *state_.sm;
+    const size_t n = sm.size();
+    if (n < 10 || params_.scan_context_num_rings == 0 ||
+        params_.scan_context_num_sectors == 0)
+    {
+        MRPT_LOG_WARN("Scan Context endpoint search skipped: invalid map or descriptor dimensions.");
+        return;
+    }
+
+    const size_t startCount = std::max<size_t>(
+        1, static_cast<size_t>(
+               std::floor(n * params_.scan_context_start_window_percent / 100.0)));
+    const size_t endCount = std::max<size_t>(
+        1,
+        static_cast<size_t>(std::floor(n * params_.scan_context_end_window_percent / 100.0)));
+    const size_t endFirst = n > endCount ? n - endCount : 0;
+    const size_t rings = params_.scan_context_num_rings;
+    const size_t sectors = params_.scan_context_num_sectors;
+
+    struct Descriptor
+    {
+        frame_id_t id = 0;
+        std::vector<float> context;
+        std::vector<float> ringKey;
+    };
+
+    auto makeDescriptor = [&](frame_id_t id) -> std::optional<Descriptor>
+    {
+        auto pc = get_cached_pointcloud(id, 0);
+        if (!pc) return std::nullopt;
+
+        std::shared_ptr<mrpt::maps::CPointsMap> points;
+        if (const auto it = pc->layers.find(params_.kiss_matcher_layer);
+            it != pc->layers.end())
+            points = std::dynamic_pointer_cast<mrpt::maps::CPointsMap>(it->second);
+        if (!points)
+        {
+            size_t largest = 0;
+            for (const auto& [name, layer] : pc->layers)
+            {
+                const auto p = std::dynamic_pointer_cast<mrpt::maps::CPointsMap>(layer);
+                if (p && p->size() > largest)
+                {
+                    points = p;
+                    largest = p->size();
+                }
+            }
+        }
+        if (!points || points->empty()) return std::nullopt;
+
+        Descriptor d;
+        d.id = id;
+        d.context.assign(rings * sectors, 0.0f);
+        d.ringKey.assign(rings, 0.0f);
+        const auto& xs = points->getPointsBufferRef_x();
+        const auto& ys = points->getPointsBufferRef_y();
+        const auto& zs = points->getPointsBufferRef_z();
+        for (size_t k = 0; k < points->size(); k++)
+        {
+            const double r = std::hypot(xs[k], ys[k]);
+            if (r <= 0.1 || r > params_.scan_context_max_radius) continue;
+            double a = std::atan2(ys[k], xs[k]);
+            if (a < 0) a += 2.0 * M_PI;
+            const size_t ri = std::min(
+                rings - 1,
+                static_cast<size_t>(r / params_.scan_context_max_radius * rings));
+            const size_t si = std::min(
+                sectors - 1, static_cast<size_t>(a / (2.0 * M_PI) * sectors));
+            // A positive offset preserves below-sensor terrain while max-height
+            // pooling retains the characteristic vertical structures.
+            d.context[ri * sectors + si] =
+                std::max(d.context[ri * sectors + si], static_cast<float>(zs[k] + 3.0));
+        }
+        for (size_t r = 0; r < rings; r++)
+        {
+            double sum = 0;
+            for (size_t s = 0; s < sectors; s++) sum += d.context[r * sectors + s];
+            d.ringKey[r] = static_cast<float>(sum / sectors);
+        }
+        return d;
+    };
+
+    std::vector<Descriptor> starts, ends;
+    MRPT_LOG_INFO_STREAM(
+        "Scan Context: building descriptors for frames [0," << startCount - 1 << "] and ["
+                                                             << endFirst << "," << n - 1 << "]");
+    for (size_t i = 0; i < startCount; i++)
+        if (auto d = makeDescriptor(static_cast<frame_id_t>(i)); d) starts.push_back(std::move(*d));
+    for (size_t i = endFirst; i < n; i++)
+        if (auto d = makeDescriptor(static_cast<frame_id_t>(i)); d) ends.push_back(std::move(*d));
+
+    auto ringDistance = [&](const Descriptor& a, const Descriptor& b)
+    {
+        double sum = 0;
+        for (size_t r = 0; r < rings; r++)
+        {
+            const double e = a.ringKey[r] - b.ringKey[r];
+            sum += e * e;
+        }
+        return std::sqrt(sum);
+    };
+    auto contextDistance = [&](const Descriptor& a, const Descriptor& b)
+    {
+        double best = 1.0;
+        size_t bestShift = 0;
+        for (size_t shift = 0; shift < sectors; shift++)
+        {
+            double similarity = 0;
+            size_t validColumns = 0;
+            for (size_t s = 0; s < sectors; s++)
+            {
+                double dot = 0, na = 0, nb = 0;
+                const size_t bs = (s + shift) % sectors;
+                for (size_t r = 0; r < rings; r++)
+                {
+                    const double va = a.context[r * sectors + s];
+                    const double vb = b.context[r * sectors + bs];
+                    dot += va * vb;
+                    na += va * va;
+                    nb += vb * vb;
+                }
+                if (na > 1e-9 && nb > 1e-9)
+                {
+                    similarity += dot / std::sqrt(na * nb);
+                    validColumns++;
+                }
+            }
+            const double distance =
+                validColumns == 0 ? 1.0 : 1.0 - similarity / validColumns;
+            if (distance < best)
+            {
+                best = distance;
+                bestShift = shift;
+            }
+        }
+        return std::make_pair(best, bestShift);
+    };
+
+    struct Match
+    {
+        double distance = 1.0;
+        frame_id_t early = 0, late = 0;
+        size_t yawShift = 0;
+    };
+    std::vector<Match> matches;
+    for (const auto& a : starts)
+    {
+        std::vector<std::pair<double, size_t>> shortlist;
+        shortlist.reserve(ends.size());
+        for (size_t j = 0; j < ends.size(); j++)
+            shortlist.emplace_back(ringDistance(a, ends[j]), j);
+        const size_t keep = std::min(params_.scan_context_ringkey_candidates, shortlist.size());
+        std::partial_sort(
+            shortlist.begin(), shortlist.begin() + keep, shortlist.end(),
+            [](const auto& x, const auto& y) { return x.first < y.first; });
+        for (size_t k = 0; k < keep; k++)
+        {
+            const auto& b = ends[shortlist[k].second];
+            const auto [distance, shift] = contextDistance(a, b);
+            matches.push_back({distance, a.id, b.id, shift});
+        }
+    }
+    std::sort(
+        matches.begin(), matches.end(),
+        [](const auto& a, const auto& b) { return a.distance < b.distance; });
+
+    params_.manual_loop_constraints.clear();
+    int hypothesisId = 0;
+    std::vector<std::pair<frame_id_t, frame_id_t>> selectedAnchors;
+    for (const auto& m : matches)
+    {
+        bool diverse = true;
+        for (const auto& [a, b] : selectedAnchors)
+            if (std::abs(static_cast<int>(m.early) - static_cast<int>(a)) <
+                    static_cast<int>(params_.scan_context_pair_frame_stride) &&
+                std::abs(static_cast<int>(m.late) - static_cast<int>(b)) <
+                    static_cast<int>(params_.scan_context_pair_frame_stride))
+                diverse = false;
+        if (!diverse) continue;
+
+        for (const int lateDirection : {1, -1})
+        {
+            std::vector<std::pair<frame_id_t, frame_id_t>> pairs;
+            for (size_t p = 0; p < params_.scan_context_pairs_per_hypothesis; p++)
+            {
+                const int ei = static_cast<int>(m.early) +
+                               static_cast<int>(p * params_.scan_context_pair_frame_stride);
+                const int lj = static_cast<int>(m.late) +
+                               lateDirection *
+                                   static_cast<int>(p * params_.scan_context_pair_frame_stride);
+                if (ei < 0 || lj < 0 || ei >= static_cast<int>(startCount) ||
+                    lj < static_cast<int>(endFirst) || lj >= static_cast<int>(n))
+                {
+                    pairs.clear();
+                    break;
+                }
+                pairs.emplace_back(static_cast<frame_id_t>(ei), static_cast<frame_id_t>(lj));
+            }
+            if (pairs.empty()) continue;
+            hypothesisId++;
+            for (const auto& [ei, lj] : pairs)
+            {
+                const auto oi = sm.get(ei).sf->getObservationByIndex(0);
+                const auto oj = sm.get(lj).sf->getObservationByIndex(0);
+                Parameters::ManualLoopConstraint c;
+                c.timestamp_i = mrpt::Clock::toDouble(oi->timestamp);
+                c.timestamp_j = mrpt::Clock::toDouble(oj->timestamp);
+                c.hypothesis_id = hypothesisId;
+                c.sigma_xyz = 0.20;
+                params_.manual_loop_constraints.push_back(c);
+            }
+            MRPT_LOG_INFO_STREAM(
+                "Scan Context candidate " << hypothesisId << ": anchor " << m.early << "<->"
+                                          << m.late << ", distance=" << m.distance
+                                          << ", yaw=" << 360.0 * m.yawShift / sectors
+                                          << " deg, traversal="
+                                          << (lateDirection > 0 ? "same" : "reverse"));
+            if (static_cast<size_t>(hypothesisId) >= params_.scan_context_max_hypotheses)
+                break;
+        }
+        selectedAnchors.emplace_back(m.early, m.late);
+        if (static_cast<size_t>(hypothesisId) >= params_.scan_context_max_hypotheses) break;
+    }
+    MRPT_LOG_INFO_STREAM(
+        "Scan Context generated " << hypothesisId << " endpoint hypotheses ("
+                                  << params_.manual_loop_constraints.size()
+                                  << " KISS/ICP constraints).");
+}
