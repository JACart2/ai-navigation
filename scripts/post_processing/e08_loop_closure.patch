+mp2p_icp::metric_map_t::Ptr FrameToFrameLoopClosure::build_loop_submap(
+    frame_id_t centerId, size_t threadIdx)
+{
+    if (params_.loop_submap_half_window == 0 && params_.loop_submap_half_length_m <= 0.0)
+    {
+        return get_cached_pointcloud(centerId, threadIdx);
+    }
+
+    ASSERT_(state_.sm);
+    const auto frameCount = state_.sm->size();
+    if (frameCount == 0 || centerId >= frameCount)
+    {
+        return {};
+    }
+
+    size_t first = centerId > params_.loop_submap_half_window
+                       ? centerId - params_.loop_submap_half_window
+                       : 0;
+    size_t last = std::min(
+        frameCount - 1, static_cast<size_t>(centerId) + params_.loop_submap_half_window);
+    if (params_.loop_submap_half_length_m > 0.0)
+    {
+        first = centerId;
+        double travelled = 0.0;
+        while (first > 0 && travelled < params_.loop_submap_half_length_m)
+        {
+            travelled +=
+                (frame_pose_in_simplemap(first).translation() -
+                 frame_pose_in_simplemap(first - 1).translation()).norm();
+            --first;
+        }
+        last = centerId;
+        travelled = 0.0;
+        while (last + 1 < frameCount && travelled < params_.loop_submap_half_length_m)
+        {
+            travelled +=
+                (frame_pose_in_simplemap(last + 1).translation() -
+                 frame_pose_in_simplemap(last).translation()).norm();
+            ++last;
+        }
+    }
+
+    auto       submap     = mp2p_icp::metric_map_t::Create();
+    const auto centerPose = frame_pose_in_simplemap(centerId);
+    size_t     merged     = 0;
+
+    for (size_t id = first; id <= last; id++)
+    {
+        auto framePc = get_cached_pointcloud(static_cast<frame_id_t>(id), threadIdx);
+        if (!framePc)
+        {
+            continue;
+        }
+
+        const auto relativePose =
+            (frame_pose_in_simplemap(static_cast<frame_id_t>(id)) - centerPose).asTPose();
+        submap->merge_with(*framePc, relativePose);
+        merged++;
+    }
+
+    if (merged == 0)
+    {
+        return {};
+    }
+
+    // Build a dedicated ordinary point layer for KISS + point-to-point ICP.
+    // Estimate the dominant horizontal Z band (normally ground), discard that
+    // band and everything below it, then optionally voxel-decimate.
+    if (params_.registration_remove_ground || params_.registration_voxel_size > 0)
+    {
+        const auto it = submap->layers.find(params_.kiss_matcher_layer);
+        if (it != submap->layers.end())
+        {
+            const auto input = std::dynamic_pointer_cast<mrpt::maps::CPointsMap>(it->second);
+            if (input && !input->empty())
+            {
+                constexpr double Z_BIN = 0.10;
+                std::unordered_map<int, size_t> zHistogram;
+                const auto& zs = input->getPointsBufferRef_z();
+                for (const float z : zs)
+                {
+                    zHistogram[static_cast<int>(std::floor(z / Z_BIN))]++;
+                }
+
+                const auto groundIt = std::max_element(
+                    zHistogram.begin(), zHistogram.end(),
+                    [](const auto& a, const auto& b) { return a.second < b.second; });
+                const double groundZ =
+                    groundIt == zHistogram.end() ? 0.0 : (groundIt->first + 0.5) * Z_BIN;
+
+                struct VoxelKey
+                {
+                    int x = 0, y = 0, z = 0;
+                    bool operator==(const VoxelKey& o) const
+                    {
+                        return x == o.x && y == o.y && z == o.z;
+                    }
+                };
+                struct VoxelHash
+                {
+                    size_t operator()(const VoxelKey& k) const
+                    {
+                        size_t h = std::hash<int>{}(k.x);
+                        h ^= std::hash<int>{}(k.y) + 0x9e3779b9 + (h << 6) + (h >> 2);
+                        h ^= std::hash<int>{}(k.z) + 0x9e3779b9 + (h << 6) + (h >> 2);
+                        return h;
+                    }
+                };
+
+                std::unordered_set<VoxelKey, VoxelHash> occupied;
+                auto output = mrpt::maps::CSimplePointsMap::Create();
+                output->reserve(input->size());
+
+                const auto& xs = input->getPointsBufferRef_x();
+                const auto& ys = input->getPointsBufferRef_y();
+                for (size_t k = 0; k < input->size(); k++)
+                {
+                    if (params_.registration_remove_ground &&
+                        zs[k] <= groundZ + params_.registration_ground_band)
+                    {
+                        continue;
+                    }
+                    if (params_.registration_voxel_size > 0)
+                    {
+                        const double v = params_.registration_voxel_size;
+                        const VoxelKey key{
+                            static_cast<int>(std::floor(xs[k] / v)),
+                            static_cast<int>(std::floor(ys[k] / v)),
+                            static_cast<int>(std::floor(zs[k] / v))};
+                        if (!occupied.insert(key).second)
+                        {
+                            continue;
+                        }
+                    }
+                    output->insertPointFast(xs[k], ys[k], zs[k]);
+                }
+
+                submap->layers[params_.kiss_matcher_layer] = output;
+                MRPT_LOG_INFO_STREAM(
+                    "Prepared non-ground registration cloud for frame " << centerId
+                    << ": ground_z=" << groundZ << " m, points " << input->size() << " -> "
+                    << output->size());
+            }
+        }
+    }
+    submap->id = static_cast<uint64_t>(centerId);
+    MRPT_LOG_INFO_STREAM(
+        "Built loop submap centered at frame " << centerId << " from " << merged
+                                                << " keyframes [" << first << ", " << last
+                                                << "]");
+    return submap;
+}
